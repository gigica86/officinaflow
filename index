function benchmarkPanel(){return `<div class="benchmark-panel"><h3>Base di riferimento · ottobre 2026</h3><div class="target-legend"><span class="target-missed">● Fuori target</span><span class="target-near">● Vicino (entro il 10%)</span><span class="target-ok">● Raggiunto</span></div><p>Per le soglie minime: giallo dal 90% del target fino al target escluso. Per le massime: giallo oltre il target fino al 110% incluso. Senza dati il valore resta neutro. La fascia del 10% è una scelta operativa.</p><ul><li><b>Quota produttiva ≥ 85%</b>: obiettivo iniziale adottato per le ore lavorate sul totale registrato. <a href="https://myautoshoppro.com/tools/technician-efficiency-calculator" target="_blank" rel="noopener">MyAutoShopPro</a> indica 85% per ore su ordini / ore disponibili: è un riferimento orientativo, perché qui il denominatore comprende lavoro, pausa e pulizia registrati.</li><li><b>Efficienza ≥ 100%</b>: ore riconosciute / ore effettive. <a href="https://www.ratchetandwrench.com/sponsored-content/autozone/article/33010643/the-kpi-technician-efficiency" target="_blank" rel="noopener">AutoZone · KPI Technician Efficiency</a> indica un obiettivo del 100% o superiore.</li><li><b>Valore orario ≥ 60 €/h</b>: base arrotondata dal riferimento 2026 di <a href="https://confartigianato.cagliari.it/autoriparatori-depositate-le-tariffe-medie-di-manodopera-per-il-2026/" target="_blank" rel="noopener">Confartigianato Sud Sardegna</a>, 59,71 €/h + IVA. È un dato territoriale di tariffa: qui misuriamo invece il ricavo riconosciuto per ora effettiva. Per confrontarli inserisci importi al netto IVA e adatta il target ai tuoi costi e al reparto.</li><li><b>Attesa iniziale ≤ 24 h · Permanenza ≤ 72 h · Attesa ricambi ≤ 24 h</b>: obiettivi operativi proposti per avviare il monitoraggio, non medie certificate di settore. Sono ore di calendario, comprese notti e fine settimana; da calibrare sul tipo di intervento, soprattutto in carrozzeria.</li></ul><p>I valori già personalizzati restano attivi; i target mancanti ricevono la base. Un campo lasciato vuoto e salvato disattiva il confronto. “Usa target di base” prepara i valori: premi Salva target per confermarli.</p></div>`}
function settingsPage(){return `<section class="card settings-card"><h2>Target dell’officina</h2><p>I target di base sono già impostati e puoi modificarli. Lascia vuoto un campo per disattivare il confronto. Le soglie si applicano ai dati del periodo e del reparto selezionati.</p><form id="targets-form">${benchmarkPanel()}<div class="fields">${definitions.map(([key,label,unit,max,direction,help])=>`<label>${label} · ${direction==='min'?'minimo':'massimo'} (${unit})<input name="${key}" type="number" min="0" max="${max}" step="0.01" value="${esc(state.settings.targets[key]??'')}" placeholder="Non impostato"><small>${help}</small></label>`).join('')}</div><p class="settings-note">I target sono conservati in questo browser e inclusi nel backup JSON. Non modificano le ore o gli importi riconosciuti delle singole lavorazioni.</p><div class="error" role="alert"></div><div class="form-actions"><button type="button" id="base-targets">Usa target di base</button><button type="button" id="cancel-targets">Annulla modifiche</button><button class="primary" type="submit">Salva target</button></div></form></section>`}
const topics=[
 ['Ore e produttività','Registra per ogni dipendente le ore di lavoro, pausa e pulizia in ore decimali: 1,5 h corrisponde a 1 ora e 30 minuti. La somma della singola registrazione deve essere maggiore di zero e non superare 24 h.','Quota produttiva = ore lavorate / (lavoro + pausa + pulizia) × 100. Il totale della squadra usa la somma delle ore, non la media delle percentuali. Il periodo e il filtro dipendente aggiornano grafici, registro e dettaglio dipendenti.'],
 ['Mezzi e lavorazioni','La scheda mezzo contiene targa, telaio, difetto, ingresso, uscita e attese ricambi. Aggiungi una lavorazione, scegli Meccanica, Carrozzeria o Gommista e collega le ore degli operatori alla lavorazione corretta.','Le ore non assegnate restano nelle ore lavorate del mezzo, ma non entrano nell’efficienza delle lavorazioni. Il filtro reparto considera le lavorazioni di quel reparto e le ore collegate; la ricerca del mezzo consulta tutto l’archivio.'],
 ['Efficienza e valore orario','Ore riconosciute e importo riconosciuto si inseriscono nella lavorazione. Per concluderla servono entrambi i valori e la data di conclusione; zero è ammesso. Le lavorazioni aperte hanno risultati provvisori.','Efficienza = ore riconosciute / ore effettive × 100. Esempio: 6 h riconosciute e 5 h effettive = 120%. Valore orario = importo riconosciuto / ore effettive. I riepiloghi usano le lavorazioni concluse nel periodo con ore effettive maggiori di zero; il valore orario usa il rapporto tra i totali.'],
 ['Tempi e attese','Attesa iniziale stimata = tempo tra ingresso e primo intervento con ore di lavoro registrate. Permanenza = tempo tra ingresso e uscita; per un mezzo presente, fino al momento attuale. Si tratta di ore di calendario, inclusi notti e fine settimana.','Media e mediana dell’attesa iniziale si basano sui mezzi usciti nel periodo con primo intervento registrato. La permanenza media considera i mezzi usciti nel periodo. Un mezzo senza interventi non ha un’attesa iniziale misurabile.'],
 ['Attesa ricambi','Nella scheda mezzo aggiungi gli intervalli di attesa ricambi. Lascia la fine vuota se l’attesa è in corso. Gli intervalli devono rientrare nella permanenza del mezzo e non sovrapporsi.','Il totale conta le ore degli intervalli comprese nel periodo. La media divide il totale per il numero di mezzi con attesa nel periodo. Attesa iniziale e attesa ricambi possono sovrapporsi: non sommarle.'],
 ['Grafici e gaussiana','Le barre della distribuzione mostrano il numero reale di lavorazioni nelle fasce di efficienza. La gaussiana è una curva di riferimento stimata dai risultati disponibili.','μ indica la media delle efficienze delle singole lavorazioni e σ la deviazione standard in punti percentuali. Questa media può differire dall’efficienza complessiva, che è un rapporto tra totali. Servono almeno tre lavorazioni e una variabilità diversa da zero per mostrare la curva.'],
 ['Target e confronto','Apri Impostazioni dal menu laterale o dall’icona in alto, quindi modifica i target e premi Salva target. I campi vuoti disattivano il confronto.','Produttività, efficienza e valore orario hanno una soglia minima; attesa iniziale, permanenza e attesa ricambi hanno una soglia massima. Verde: target raggiunto, uguaglianza compresa. Giallo: scostamento sfavorevole fino al 10% del target. Rosso: scostamento maggiore o valore negativo. La fascia del 10% è una scelta operativa, non un benchmark di settore. In assenza di dati il confronto indica “Dati insufficienti”.'],
 ['Registri, Excel e backup','Apri un registro per consultare, cercare e modificare i dati. Il pulsante Excel del registro esporta il relativo elenco. Dalle impostazioni in alto puoi importare Excel o esportare dati e grafici.','Il backup JSON include tutti i dati e i target ed è ripristinabile nello stesso software. Importare un backup sostituisce i dati attuali. I dati sono salvati nel browser: usa il backup per conservarli o trasferirli su un altro dispositivo. “Inizia da zero” svuota i registri e conserva i target.']
];
function guidePage(){return `<div class="guide-intro"><p>Le spiegazioni di riferimento per usare Officina Flow e leggere correttamente i risultati.</p><div class="guide-index">${topics.map(([title],i)=>`<a href="#guide-${i}">${title}</a>`).join('')}</div></div><div class="guide-sections">${topics.map(([title,...paragraphs],i)=>`<section class="card guide-card" id="guide-${i}"><h2>${title}</h2>${paragraphs.map(p=>`<p>${p}</p>`).join('')}</section>`).join('')}</div>`}
const previousRender=render;render=function(){validateSettings(state);const utility=tab==='guide'||tab==='settings';$('.notice').hidden=utility;$('#add').hidden=utility;if(!utility){previousRender();return}$('#breadcrumb').textContent=$('#title').textContent=tab==='guide'?'Guida e riferimenti':'Impostazioni';$('#period').hidden=true;$('#employee-filter').hidden=true;document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.tab===tab));$('#view').innerHTML=tab==='guide'?guidePage():settingsPage();if(tab==='settings'){
 $('#base-targets').onclick=()=>{for(const [key] of definitions)$('#targets-form [name='+key+']').value=defaults[key];toast('Target di base caricati. Premi Salva target per applicarli.')};$('#cancel-targets').onclick=()=>render();$('#targets-form').onsubmit=e=>{e.preventDefault();try{const fd=new FormData(e.target),targets={};for(const [key]of definitions){const raw=fd.get(key);targets[key]=raw===''?null:Number(raw)}const candidate={...state,settings:{...state.settings,targets}};validateSettings(candidate);localStorage.setItem(KEY,JSON.stringify(candidate));state=candidate;render();toast('Target salvati.')}catch(error){$('#targets-form .error').textContent=error.message}};
 }};
$('#edit-targets').onclick=()=>{tab='settings';query='';render()};save();render();return{definitions,defaults,validateSettings,evaluate,comparison,metric};
